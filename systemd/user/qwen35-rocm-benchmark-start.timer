[Unit]
Description=Resume ROCm benchmark generation every 10 minutes from 08:00 to 23:20 Madrid time

[Timer]
OnCalendar=*-*-* 08..22:00/10:00 Europe/Madrid
OnCalendar=*-*-* 23:00..20/10:00 Europe/Madrid
AccuracySec=1s
Persistent=true
Unit=qwen35-rocm-benchmark-start.service

[Install]
WantedBy=timers.target
